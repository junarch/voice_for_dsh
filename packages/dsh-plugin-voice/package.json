{
  "name": "dsh-plugin-voice",
  "version": "0.4.0",
  "description": "DSH web plugin: read aloud each DeepSeek turn output after spoken-style transcription (code/table/markdown aware), with per-message manual read buttons and an auto-read toggle.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node -e \"console.log('dsh-plugin-voice: lib/ is hand-authored plain JS, nothing to build')\""
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0",
    "sherpa-onnx-node": "1.13.8"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.3",
        "@deepseek-ai/dsh-settings": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
        "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/cordis": { "optional": true }
  },
  "license": "MIT"
}
